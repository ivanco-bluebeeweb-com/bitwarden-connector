{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "bitwarden-connector",
  "version": "0.1.0",
  "name": "Bitwarden",
  "description": "Connect your own Bitwarden organization (Public API, OAuth2 client_credentials) to manage members, collections, groups, event logs, and policies -- full read/write plus value-add organization health and inactive-member reports.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "bitwarden:read",
    "bitwarden:write"
  ],
  "tools": [
    {
      "name": "connect_bitwarden",
      "description": "Connect your own Bitwarden organization by saving its Public API client_id/client_secret, after checking they actually work.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:resource"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "A friendly name for this organization, e.g. 'Acme Corp'.",
            "title": "Label",
            "type": "string"
          },
          "client_id": {
            "description": "Organization API client_id, format organization.{uuid} (Settings > My Organization > API Key).",
            "title": "Client Id",
            "type": "string"
          },
          "client_secret": {
            "description": "Organization API client_secret from the same API Key screen.",
            "title": "Client Secret",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "client_secret"
        ],
        "title": "ConnectBitwardenParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "title": "Connection Id",
            "type": "string"
          },
          "label": {
            "default": "",
            "title": "Label",
            "type": "string"
          },
          "member_count": {
            "default": 0,
            "title": "Member Count",
            "type": "integer"
          }
        },
        "title": "ConnectBitwardenResult",
        "type": "object"
      },
      "event": "bitwarden-connector.connect_bitwarden",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_bitwarden-connector_chat"
    },
    {
